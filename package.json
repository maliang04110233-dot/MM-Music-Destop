{
  "name": "music-downloader",
  "version": "1.0.18",
  "description": "多平台音乐下载器 - 支持网易云/QQ音乐/B站/酷狗/酷我",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "build": "vite build && node scripts/postbuild.js",
    "package": "vite build && node scripts/postbuild.js && electron-builder --config build/config.cjs --win --x64",
    "publish": "vite build && node scripts/postbuild.js && electron-builder --config build/config.cjs --publish always",
    "postinstall": "electron-builder install-app-deps",
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint src/ test/"
  },
  "keywords": [
    "music",
    "downloader",
    "electron"
  ],
  "author": "MusicDL",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.0.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.0.0",
    "eslint": "^8.57.0",
    "vite": "^5.4.21",
    "vite-plugin-electron": "^1.0.4",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "electron-updater": "^6.8.9",
    "iconv-lite": "^0.6.3",
    "music-metadata": "^7.14.0",
    "NeteaseCloudMusicApi": "^4.32.0",
    "node-id3": "^0.2.9",
    "qq-music-api": "^1.1.2"
  },
  "overrides": {},
  "build": {
    "extends": null
  }
}
